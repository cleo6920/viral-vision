            primaryPurposeLock = await runPrimaryPurposeLock(apiKey, contentHierarchy, trace, modelTier);
            
            // --- NEW: PRIMARY PURPOSE LOCK SANITIZATION (PERSONA ONLY) ---
            if (primaryPurposeLock && coreIntentClassification?.coreIntent === 'PERSONA') {
              const humanKeywords = ["donna", "uomo", "ragazzo", "ragazza", "bambino", "anziano", "persona", "protagonista", "volto", "sguardo", "gesto", "attore", "human", "person", "woman", "man"];
              const isHuman = (text: string) => humanKeywords.some(hk => text.toLowerCase().includes(hk));

              if (Array.isArray(primaryPurposeLock.elementsClassification)) {
                  primaryPurposeLock.elementsClassification = primaryPurposeLock.elementsClassification.map((el: any) => {
                    if (el.role === 'CORE_DRIVER' && !isHuman(el.element)) {
                        el.role = 'SUPPORT';
                    }
                    if (isHuman(el.element)) {
                        el.role = 'CORE_DRIVER';
                    }
                    return el;
                  });
              }
            }
            
            if (primaryPurposeLock) {
               if (onProgress) onProgress("Validazione Ruolo Funzionale...");
               functionalRoleLock = await runFunctionalRoleLock(apiKey, contentHierarchy, primaryPurposeLock, trace, modelTier);
            }

            if (functionalRoleLock) {
               if (onProgress) onProgress("Validazione Idea Anchor...");
               ideaAnchorLock = await runIdeaAnchorLock(apiKey, contentHierarchy, primaryPurposeLock, functionalRoleLock, trace, modelTier);
               
               if (!ideaAnchorLock || ideaAnchorLock.lockStatus === "FAIL") {
