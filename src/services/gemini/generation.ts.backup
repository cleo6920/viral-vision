    // --- LAYER 0: CORE_INTENT_CLASSIFIER ---
    if (onProgress) onProgress("Classificazione Intento Core...");
    let coreIntentClassification: any = null;
    try {
      const { runCoreIntentClassifier } = await import("./analysis");
      coreIntentClassification = await runCoreIntentClassifier(baseParts, apiKey, currentModelTier, onProgress, trace, videoSummary);
      
      if (coreIntentClassification?.isFallback) {
        engineReliability = "DEGRADED";
        engineWarnings.push({
          module: "CORE_INTENT_CLASSIFIER",
          status: "FAILED_WITH_FALLBACK",
          errorType: coreIntentClassification.errorType || "SERVICE_ERROR",
          fallbackApplied: true,
          impact: "intent downgraded to ALTRO / LEGACY_DEFAULT"
        });
      }
    } catch (e) {
      if (handleQuotaError("CORE_INTENT_CLASSIFIER", e)) throw e;

      logger.error("[CORE_INTENT_CLASSIFIER_PIPELINE_ERROR]", e);
      engineReliability = "DEGRADED";
      engineWarnings.push({
        module: "CORE_INTENT_CLASSIFIER",
        status: "FAILED_WITHOUT_FALLBACK_DATA",
        errorType: "CRITICAL_ERROR",
        fallbackApplied: true,
        impact: "intent unknown, using ALTRO"
      });
    }

    // --- LAYER 0.1: STRATEGIC ROUTING ENGINE ---
    const isFileStatic = !providedFileUri && file && file.type.startsWith('image/');
    const hasActiveVideoEvidence = !!(
      (file && file.type.startsWith('video/')) ||
