    const isStrictStatic = strategicManifest.sourceType === "STATIC_IMAGE" || strategicManifest.sourceType === "POSTER" || strategicManifest.sourceType === "FLYER";
    if (isStrictStatic) {
        logger.warn("[STRATEGIC_ROUTING][STATIC_IMAGE_LOCKED] Forced eventCategory=NONE to prevent materialization.");
        if (coreIntentClassification) {
            coreIntentClassification.eventCategory = "NONE";
            coreIntentClassification.selectedEvent = "NONE";
