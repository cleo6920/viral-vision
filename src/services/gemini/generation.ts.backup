    const sourceTypeLocked = rawSourceType;

    // --- LAYER 0.2: CONTENT_HIERARCHY_REASONER ---
    let contentHierarchy: any = null;
    if (!runAbortReason) {
      try {
        contentHierarchy = await runContentHierarchyReasoner(baseParts, apiKey, coreIntentClassification, strategicManifest, sessionId, sourceTypeLocked, trace, videoSummary, modelTier);

        if (contentHierarchy?.isFallback) {
