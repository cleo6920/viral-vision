/**
 * Dual-Inventory Enforcement Non-AI Logic
 */
async function executeGroqFirstHierarchyTask(params: {
  preferGroq: boolean;
  prompt: string;
  systemInstruction: string;
  timeoutMs: number;
  apiKey?: string;
  model: string;
  trace?: ModelUsageTrace;
  geminiOp: (currentAi: any, dynamicModel?: string) => Promise<any>;
}) {
  if (params.preferGroq && hasGroqApiKey()) {
    logger.info('[GROQ_TEXT_REASONING_ROUTE] layer=Content Hierarchy Reasoner taskType=SCRIPT_ANALYSIS');
    try {
      const groq = await groqTextCompletion({
        messages: [
          { role: 'system', content: params.systemInstruction },
          { role: 'user', content: params.prompt },
        ],
        responseFormat: 'json_object',
        timeoutMs: params.timeoutMs,
      });
      return { text: groq.text };
    } catch (err) {
      logger.warn('[GROQ_TEXT_REASONING_FAILED] layer=Content Hierarchy Reasoner', err);
    }
  }

  return await executeWithNetworkRetry(
    params.geminiOp,
    1,
    undefined,
    params.timeoutMs,
    params.apiKey,
    undefined,
    params.model,
    params.trace,
    'Content Hierarchy Reasoner',
    'flash',
    false,
    'COGNITIVE',
    false,
    'Semantic hierarchy construction',
    'video_summary',
    true,
    false,
    'SCRIPT_ANALYSIS'
  );
}

