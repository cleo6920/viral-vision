export async function boostViralImpact(
  prompt: string,
  apiKey: string,
  genre: string,
  modelTier: string = "flash",
  trace?: ModelUsageTrace,
): Promise<any> {
  const executeBoost = async (currentModelTier: string) => {
    const { ai } = getAI(apiKey);
    const model = selectModel(
      currentModelTier === "pro" ? "pro" : "flash",
      "flash",
      apiKey,
    );

    const fullPrompt = `
      PRODUCTION FLOW Ã¢â‚¬â€ VIRAL ENGINE MODE (MANDATORY)
      STEP 4 Ã¢â‚¬â€ VIRAL BOOST

      Applica un Boost Virale a questi prompt per il genere ${genre}.
      
      Prompt originali:
      ${prompt}
      
      MODALITÃƒâ‚¬ VIRALE CREATIVA:
      Aggiungi:
      - 1 Micro-problema visivo all'inizio.
      - 1 Micro-sorpresa a metÃƒÂ .
      - 1 Momento umano finale.

      DIVIETO ASSOLUTO:
      - Nessuna aggiunta estetica inutile (es. "luci al neon", "cinematic lighting").
      - Nessun rallenty se non serve alla gag.
    `;

    const response = await executeWithNetworkRetry(async (currentAi, dynamicModel) =>
        currentAi.models.generateContent({
        model: dynamicModel || model,
          contents: { parts: [{ text: fullPrompt }] },
          config: {
            responseMimeType: "application/json",
            responseSchema: VIRAL_BOOST_SCHEMA,
          },
        }),
      3,
      undefined,
      300000,
      apiKey,
      undefined,
      model,
      trace,
      "Viral Boost",
      currentModelTier
    );

    const parsed = safeParseJSON(response.text || "{}");

    if (parsed.prompts) {
      const formattedPrompt = `
<viral_boost_analysis>
Visual Micro Problem: ${parsed.visualMicroProblem}
Micro Surprise: ${parsed.microSurprise}
Final Human Moment: ${parsed.finalHumanMoment}
</viral_boost_analysis>

<visual_prompt_15s>
${parsed.prompts.prompt15s}
</visual_prompt_15s>

<visual_prompt_12s>
${parsed.prompts.prompt12s}
</visual_prompt_12s>

<visual_prompt_10s>
${parsed.prompts.prompt10s}
</visual_prompt_10s>

<visual_prompt_8s>
${parsed.prompts.prompt8s}
</visual_prompt_8s>

<visual_prompt_6s>
${parsed.prompts.prompt6s}
</visual_prompt_6s>
`.trim();

      return formattedPrompt;
    }

    return parsed;
  };

  try {
    return await executeBoost(modelTier);
  } catch (err: any) {
    throw err;
  }
}

export async function generateGuidedShort(
  genre: string,
  idea: string,
  cast: string,
  promise: string,
  reference: string,
  apiKey: string,
  modelTier: string = "flash",
  useBypass: boolean = false,
  trace?: ModelUsageTrace,
): Promise<any> {
  const { ai } = getAI(apiKey);
  const plannedModel = selectModel(
    modelTier === "pro" ? "pro" : "flash",
    "flash",
    apiKey,
  );

  const fullPrompt = `
    MODALITÃƒâ‚¬: guided-short
    GENERE: ${genre}
    IDEA DI BASE: ${idea}
    CAST: ${cast}
    PROMESSA: ${promise}
    RIFERIMENTO: ${reference}
    BYPASS: ${useBypass ? 'ATTIVO' : 'DISATTIVO'}
    
    Genera il pacchetto completo richiesto seguendo il formato JSON specificato nelle istruzioni di sistema.
  `;

  const response = await executeWithNetworkRetry(
    (currentAi, dynamicModel) =>
      currentAi.models.generateContent({
        model: dynamicModel || plannedModel,
        contents: { parts: [{ text: fullPrompt }] },
        config: {
          systemInstruction: SYSTEM_INSTRUCTION,
          responseMimeType: "application/json",
          responseSchema: FULL_VIDEO_ANALYSIS_SCHEMA,
        },
      }),
    3,
    undefined,
    300000,
    apiKey,
    undefined,
    plannedModel,
    trace,
    "Guided Short Generation",
    modelTier
  );
  return { text: response.text || "", modelUsed: plannedModel };
}

export async function mergeScripts(
  results: any[],
  apiKey: string,
  modelTier: string = "flash",
): Promise<any> {
  const executeMerge = async (currentModelTier: string) => {
    const { ai } = getAI(apiKey);
    const model = selectModel(
      currentModelTier === "pro" ? "gemini-3.1-pro-preview" : "gemini-flash-latest",
      "gemini-flash-latest",
      apiKey,
    );

    const systemInstruction = `
      Sei un esperto di regia, montaggio, analisi musicale e neuro-scienze. Il tuo compito ÃƒÂ¨ unire piÃƒÂ¹ segmenti di analisi video in un unico JSON coerente.
      Assicurati che la narrazione sia fluida, che le entitÃƒÂ  (identityMapping) siano unificate e che non ci siano duplicati o salti temporali.
      Accorpa i metadati di pubblicazione, l'analisi musicale e l'analisi neuro-scientifica in modo coerente.
      Restituisci un JSON con la struttura: { originalScript, script, identityMapping, publicationMetadata, musicAnalysis, neuroAnalysis }.
    `;

    const response = await executeWithNetworkRetry(async (currentAi, dynamicModel) =>
        currentAi.models.generateContent({
        model: dynamicModel || model,
          contents: {
            parts: [
              {
                text: `Unisci questi segmenti di trascrizione: ${JSON.stringify(results)}`,
              },
            ],
          },
          config: { systemInstruction, responseMimeType: "application/json" },
        }),
      3,
      undefined,
      300000,
    );

    return safeParseJSON(response.text || "{}");
  };

  try {
    return await executeMerge(modelTier);
  } catch (err: any) {
    throw err;
  }
}
