    result.veo3ExtensionPart2Prompt8s,
    result.klingPrompt,
    result.veoPrompt,
  ].filter((v) => typeof v === "string" && v.trim().length > 0) as string[];
}

function ensureFullAnalysisStructure(obj: any): any {
  if (!obj || typeof obj !== 'object') obj = {};
  
  const defaults: any = {
    viralScore: "UNVERIFIED",
    analysis: "INCOMPLETE ANALYSIS",
    script: "",
    originalScript: "",
    titles: [],
    hooks: [],
    aiPrompts: "",
    alternativePrompt: "",
    coverPrompt: "",
    nicheViability: "UNVERIFIED",
    nicheViabilityReason: "Incomplete data extraction",
    characterArtist: "Unknown",
    marketTrend: "Unverified",
    viralBrain: {
        patternBreak: "Unverified",
        retentionLogic: "Unverified",
        dopamineTriggers: []
    },
    publishingKit: {
        titoli: [],
        descrizione: "",
        hashtags: []
    },
    validationTrace: {
        structuralFailTriggered: true,
        reason: "Partial result received from LLM",
        regenerationCount: 0
    }
  };

  for (const key in defaults) {
    if (obj[key] === undefined || obj[key] === null || (typeof obj[key] === 'string' && obj[key].trim() === "")) {
       obj[key] = defaults[key];
    }
  }

  // Deep defaults
  if (!obj.viralBrain || typeof obj.viralBrain !== 'object') obj.viralBrain = defaults.viralBrain;
  if (!obj.publishingKit || typeof obj.publishingKit !== 'object') obj.publishingKit = defaults.publishingKit;
  
  return obj;
}

function normalizeGeneratedPromptFields(result: any) {
  // Normalize viralScore if nested
  if (!result.viralScore && result.analysis && typeof result.analysis === 'object' && result.analysis.viralScore) {
    result.viralScore = result.analysis.viralScore;
  }
  if (!result.viralScore && result.neuroScore && typeof result.neuroScore === 'object' && result.neuroScore.score) {
    result.viralScore = result.neuroScore.score;
  }
  if (!result.viralScore && result.result && typeof result.result === 'object' && result.result.viralScore) {
    result.viralScore = result.result.viralScore;
  }

  // Normalize script if nested or named differently
  if (!result.script && (result.optimizedScript || result.outputScript || result.scriptGenerated || result.finalScript || result.directorScript)) {
    result.script = result.optimizedScript || result.outputScript || result.scriptGenerated || result.finalScript || result.directorScript;
  }
  if (!result.script && result.result && typeof result.result === 'object' && result.result.script) {
    result.script = result.result.script;
  }
  
  // Normalize originalScript
  if (!result.originalScript && (result.transcript || result.detectedScript || result.literalTranscript)) {
    result.originalScript = result.transcript || result.detectedScript || result.literalTranscript;
  }

  result.script = coerceLooseText(result.script);
  result.originalScript = coerceLooseText(result.originalScript);
  result.aiPrompts = coerceLooseText(result.aiPrompts);
  result.analysis = coerceLooseText(result.analysis);
  result.alternativePrompt = coerceLooseText(result.alternativePrompt);
  result.selectedEvent = coerceLooseText(result.selectedEvent);

  result.soraPrompt12s = pickFirstNonEmptyString(
    result.soraPrompt12s,
    result.promptSora12s,
  );

  result.klingPrompt10s = pickFirstNonEmptyString(
    result.klingPrompt10s,
    result.promptKling10s,
    result["prompt_kling_10s"],
    result["kling_prompt_10s"],
  );

  result.klingPrompt15s = pickFirstNonEmptyString(
    result.klingPrompt15s,
    result.promptKling15s,
    result["prompt_kling_15s"],
    result["kling_prompt_15s"],
    result.promptKling,
    result.klingPrompt,
  );

  const seedancePrompt15s = pickFirstNonEmptyString(
    result.seedancePrompt15s,
    result.sendancePrompt15s,
    result.promptSeedance15s,
    result.promptSendance15s,
    result["prompt_seedance_15s"],
    result["prompt_sendance_15s"],
    result["seedance_prompt_15s"],
    result["sendance_prompt_15s"],
  );
  result.seedancePrompt15s = seedancePrompt15s;
  result.sendancePrompt15s = pickFirstNonEmptyString(
    result.sendancePrompt15s,
    result.seedancePrompt15s,
  );

  result.veo3Prompt8s = pickFirstNonEmptyString(
    result.veo3Prompt8s,
    result.promptVeo3_8s,
    result.promptVeo8s,
    result["prompt_veo3_8s"],
    result["veo3_prompt_8s"],
    result.promptVeo,
    result.veoPrompt,
  );

  result.veo3ExtensionPart1Prompt8s = pickFirstNonEmptyString(
    result.veo3ExtensionPart1Prompt8s,
    result.promptVeo3ExtensionPart1_8s,
    result["prompt_veo3_extension_part1_8s"],
    result["veo3_extension_part1_8s"],
  );

  result.veo3ExtensionPart2Prompt8s = pickFirstNonEmptyString(
    result.veo3ExtensionPart2Prompt8s,
    result.promptVeo3ExtensionPart2_8s,
    result["prompt_veo3_extension_part2_8s"],
    result["veo3_extension_part2_8s"],
  );

  if (!result.klingPrompt) result.klingPrompt = result.klingPrompt15s || "";
  if (!result.veoPrompt) result.veoPrompt = result.veo3Prompt8s || "";
}

function getPromptSubjectSummary(result: any): string {
  const inventory = Array.isArray(result?.promptInventory) ? result.promptInventory : [];
  const visible = Array.isArray(result?.visibleSurfaceElements) ? result.visibleSurfaceElements : [];
  const semantic = Array.isArray(result?.semanticMentions) ? result.semanticMentions : [];
  const pool = [...inventory, ...visible, ...semantic]
    .filter((value) => typeof value === "string" && value.trim().length > 0)
    .slice(0, 3);
  return pool.length > 0 ? pool.join(", ") : "the verified subjects in the original scene";
}

function getPromptBeatLines(result: any): string[] {
  const normalizedScript =
    typeof result?.finalScriptNormalized === "string" && result.finalScriptNormalized.trim().length > 0
      ? result.finalScriptNormalized
      : typeof result?.script === "string" && result.script.trim().length > 0
        ? result.script
        : buildFaithfulBeatScript(result?.originalScript || "");
  const lines = extractNarrativeBeats(normalizedScript);
  return lines.length > 0 ? lines : extractNarrativeBeats(result?.originalScript || "");
}

function getDialogueRhythmInstruction(result: any): string {
  return result?.audioVerified === true
    ? "retain cadence and recognizable key lines, use original dialogue rhythm, and sync only the key verified punchline."
    : "use narrative description only and do not invent dialogue.";
}

function safeSentenceTrim(text: string, maxChars: number): string {
  if (!text) return "";
  const normalized = text.replace(/\s+/g, " ").trim();
  if (!normalized) return "";
  if (normalized.length <= maxChars && /[.!?]"?$/.test(normalized)) {
    return normalized;
  }

  const sentences = normalized
    .split(/(?<=[.!?])\s+/)
    .map((sentence) => sentence.trim())
    .filter(Boolean);

  if (sentences.length === 0) {
    const words = normalized.split(/\s+/);
    let rebuilt = "";
    for (const word of words) {
      const candidate = rebuilt ? `${rebuilt} ${word}` : word;
      if (candidate.length > maxChars) break;
      rebuilt = candidate;
    }
    rebuilt = rebuilt.trim().replace(/[,:;\-Ã¢â‚¬â€œÃ¢â‚¬â€\s]+$/g, "");
    return rebuilt ? `${rebuilt}.` : normalized.slice(0, Math.min(maxChars, normalized.length)).trim();
  }

  let acc = "";
  for (const sentence of sentences) {
    const candidate = acc ? `${acc} ${sentence}` : sentence;
    if (candidate.length > maxChars) break;
    acc = candidate;
  }
  if (!acc) {
    const firstSentence = sentences[0];
    return firstSentence.length <= maxChars ? firstSentence : `${firstSentence.slice(0, maxChars).trim().replace(/[,:;\-Ã¢â‚¬â€œÃ¢â‚¬â€\s]+$/g, "")}.`;
  }
  return /[.!?]"?$/.test(acc) ? acc : `${acc.replace(/[,:;\-Ã¢â‚¬â€œÃ¢â‚¬â€\s]+$/g, "")}.`;
}

function sanitizePromptSegment(text: string, maxChars = 180): string {
  if (!text) return "";
  const cleaned = text
    .replace(/\[[^\]]+\]/g, " ")
    .replace(/\([^)]*\)/g, " ")
    .replace(/\s+/g, " ")
    .replace(/["'`]{2,}/g, "\"")
    .trim();
  if (!cleaned) return "";
  return safeSentenceTrim(cleaned, maxChars);
}

function dedupeSentences(text: string): string {
  if (!text) return "";
  const pieces = text
    .split(/(?<=[.!?])\s+/)
    .map((piece) => piece.trim())
    .filter(Boolean);
  const seen = new Set<string>();
  const unique: string[] = [];
  for (const piece of pieces) {
    const key = piece.toLowerCase();
    if (!seen.has(key)) {
      seen.add(key);
      unique.push(piece);
    }
  }
  return unique.join(" ").trim();
}

function stripSpeakerLabels(text: string): string {
  return text
    .replace(/\b(?:uomo|donna|coro|altri|male performer|female performer|teacher|student)\s*:\s*/gi, "")
    .replace(/\s+/g, " ")
    .trim();
}

function hasMultipleSpeakerLabels(text: string): boolean {
  const labels = text.match(/\b(?:uomo|donna|coro|altri|male performer|female performer|teacher|student)\s*:/gi) || [];
  return labels.length > 1;
}

function sanitizeItalianKeyLine(text: string): string {
  const cleaned = stripSpeakerLabels(text)
    .replace(/che cazzo/gi, "che cavolo")
    .replace(/\s+/g, " ")
    .trim();
  return sanitizePromptSegment(cleaned, 90);
}

function extractShortVerifiedLine(result: any): string {
  const script = typeof result?.script === "string" ? result.script : "";
  const originalScript = typeof result?.originalScript === "string" ? result.originalScript : "";
  const combined = `${script} ${originalScript}`;
  const quotedMatches = combined.match(/["'Ã¢â‚¬Å“Ã¢â‚¬ÂÃ‚Â«Ã‚Â»]([^"'Ã¢â‚¬Å“Ã¢â‚¬ÂÃ‚Â«Ã‚Â»]{3,120})["'Ã¢â‚¬Å“Ã¢â‚¬ÂÃ‚Â«Ã‚Â»]/g) || [];
  const cleanedQuotes = quotedMatches
    .map((match) => sanitizeItalianKeyLine(match.replace(/["'Ã¢â‚¬Å“Ã¢â‚¬ÂÃ‚Â«Ã‚Â»]/g, "")))
    .filter((value) => value.length >= 8 && value.length <= 90 && !hasMultipleSpeakerLabels(value) && (value.match(/:/g) || []).length <= 1);
  if (cleanedQuotes.length > 0) return cleanedQuotes[0];

  const beatLines = getPromptBeatLines(result);
  for (const line of beatLines) {
    if (hasMultipleSpeakerLabels(line)) continue;
    const stripped = sanitizeItalianKeyLine(line.includes(":") ? line.split(":").slice(1).join(":") : line);
    if (stripped.length >= 8 && stripped.length <= 90 && (stripped.match(/:/g) || []).length <= 1) {
      return stripped;
    }
  }

  const safeFallbacks = [
    "ÃƒË† tutta colpa di Peraccino e Pisani!",
    "Ma cosa dici?",
    "Non ho studiato!",
  ];
  const matchedFallback = safeFallbacks.find((fallback) => combined.toLowerCase().includes(fallback.toLowerCase().replace("!", "")));
  return matchedFallback || "Ma cosa dici?";
}

function extractKeyPunchline(result: any): string {
  const line = extractShortVerifiedLine(result);
  if (line) return line;
  const beats = getPromptBeatLines(result);
  return sanitizePromptSegment(beats[2] || beats[1] || beats[0] || "", 90);
}

function extractFinalPayoff(result: any): string {
  const beats = getPromptBeatLines(result);
  return sanitizePromptSegment(beats[beats.length - 1] || beats[3] || beats[2] || "", 110);
}

function getGenericVeoCastDescription(result: any): string {
  const visible = Array.isArray(result?.visibleSurfaceElements) ? result.visibleSurfaceElements.join(" ").toLowerCase() : "";
  const hasGlasses = /glasses|occhiali/.test(visible);
  return hasGlasses
    ? "a middle-aged Italian male comedian and a female Italian comedian with glasses"
    : "two Italian live cabaret performers";
}

function getVeoLanguageLockInstruction(result: any): string {
  const likelyItalian =
    /italian|only fun|interrogazione|barbara foria|raul cremona|peraccino|pisani/i.test(
      `${result?.genre || ""} ${result?.script || ""} ${result?.originalScript || ""}`,
    );
  if (!likelyItalian) {
    return "Keep the verified key line in the original spoken language. Do not translate the dialogue into English. No translated voiceover. No narrator.";
  }
  return "The spoken dialogue must remain in Italian. Do not translate the dialogue into English. Do not replace Italian speech with English speech. Keep the verified Italian line exactly in Italian. Preserve Italian mouth movement and Italian phoneme timing. The actors must speak Italian, not English. No English dialogue. No English voiceover. No narrator. No translated version of the line.";
}

