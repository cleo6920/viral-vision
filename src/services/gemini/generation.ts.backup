function extractNarrativeBeats(script: string): string[] {
  return (script || "")
    .split(/\r?\n+/)
    .map((line) => line.replace(/^\s*[-*Ã¢â‚¬Â¢\d\]\.)\s]*/, "").trim())
    .filter((line) => line.length >= 12);
}

function getTimestampLabel(index: number): string {
  const labels = ["[0-2s]", "[2-5s]", "[5-8s]", "[8-11s]", "[11-15s]"];
  return labels[index] || `[${index}]`;
}

function computeCoverageScore(sourceBeats: string[], targetBeats: string[]): number {
  if (sourceBeats.length === 0) return 0;
  const normalizedTarget = targetBeats.map((beat) => beat.toLowerCase());
  const covered = sourceBeats.filter((beat) => {
    const normalizedBeat = beat.toLowerCase();
    return normalizedTarget.some(
      (target) =>
        target.includes(normalizedBeat) ||
        normalizedBeat.includes(target),
    );
  }).length;
  return Math.max(0, Math.min(100, Math.round((covered / sourceBeats.length) * 100)));
}

function compareSeverity(
  a: "NONE" | "LOW" | "MEDIUM" | "HIGH",
  b: "NONE" | "LOW" | "MEDIUM" | "HIGH",
): "NONE" | "LOW" | "MEDIUM" | "HIGH" {
  const order = { NONE: 0, LOW: 1, MEDIUM: 2, HIGH: 3 } as const;
  return order[a] >= order[b] ? a : b;
}

function pickFirstNonEmptyString(...values: any[]): string {
  for (const value of values) {
    if (typeof value === "string" && value.trim().length > 0) {
      return value.trim();
    }
  }
  return "";
}

function coerceLooseText(value: any): string {
  if (typeof value === "string") return value.trim();
  if (typeof value === "number" || typeof value === "boolean") return String(value).trim();
  if (Array.isArray(value)) {
    return value
      .map((item) => coerceLooseText(item))
      .filter((item) => item.length > 0)
      .join("\n")
      .trim();
  }
  if (value && typeof value === "object") {
    const prioritizedKeys = [
      "text",
      "script",
      "content",
      "value",
      "prompt",
      "description",
      "summary",
      "output",
    ];
    for (const key of prioritizedKeys) {
      const normalized = coerceLooseText(value[key]);
      if (normalized) return normalized;
    }
    try {
      return JSON.stringify(value).trim();
    } catch {
      return "";
    }
  }
  return "";
}

