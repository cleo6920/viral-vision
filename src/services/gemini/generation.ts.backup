export async function generateSora2Prompt(
  frames: any[],
  idea: any,
  goal: string,
  cast: string,
  apiKey: string,
  hookStyle: string,
  genre: string,
  originalScript: string,
  modelTier: string = "flash",
  externalMarketData?: ExternalMarketData,
  trace?: ModelUsageTrace,
  videoSummary?: string
): Promise<any> {
  const executeGeneration = async (currentModelTier: string) => {
    const { ai } = getAI(apiKey);
    const model = selectModel(
      currentModelTier === "pro" ? "pro" : "flash",
      "flash",
      apiKey,
    );

    const ideaText = typeof idea === "string" ? idea : JSON.stringify(idea);

    // --- CORE_INTENT_CLASSIFIER Integration ---
    let coreIntentClassification = null;
    try {
      const { runCoreIntentClassifier } = await import("./analysis");
      coreIntentClassification = await runCoreIntentClassifier(frames, apiKey, modelTier, undefined, trace, videoSummary);
      logger.info("[Sora2] Core Intent Classified:", coreIntentClassification);
    } catch (err) {
      logger.error("[Sora2] Failed to run Core Intent Classifier:", err);
    }

    const prompt = `
      PRODUCTION FLOW Ã¢â‚¬â€ VIRAL ENGINE MODE (MANDATORY)
      STEP 3 Ã¢â‚¬â€ BASE PROMPT

      ${videoSummary ? `VIDEO SUMMARY (ANTI QUOTE WASTE): ${videoSummary}` : ""}

      ${coreIntentClassification ? `INTENTO CORE RILEVATO: ${coreIntentClassification.coreIntent}
      REGOLE DI PRIORITÃƒâ‚¬: ${coreIntentClassification.priorityRules}
      RAZIONALE: ${coreIntentClassification.reasoning}
      
      IMPORTANTE: Il prompt DEVE rispettare l'intento core sopra indicato.` : ""}

      Genera i prompt video basandoti su questa IDEA MIGLIORATA:
      IDEA: ${ideaText}
      OBIETTIVO: ${goal}
      CAST: ${cast}
      STILE HOOK: ${hookStyle}
      GENERE: ${genre}
      SCRIPT ORIGINALE: ${originalScript}
      
      ${
        externalMarketData && externalMarketData.status === "SUCCESS"
          ? `
      DATI DI MERCATO ESTERNI (REALI):
      ${JSON.stringify(externalMarketData)}
      `
          : `
      Ã¢Å¡Â Ã¯Â¸Â NO DATA MODE: Nessun dato di mercato esterno disponibile.
      `
      }

      Il prompt deve includere SEMPRE:
      REALITY ANCHOR:
      - azione fisicamente credibile
      - resistenza visiva
      - stato iniziale neutro
      - peso percepibile

      STRUTTURA:
      - HOOK (0Ã¢â‚¬â€œ1.2s)
      - ESCALATION
      - CORE ACTION
      - PAYOFF
      - LOOP
      
      Ã°Å¸Å¡Â¨ REAL VIRAL VALIDATOR (MANDATORY):
      Il base prompt DEVE essere validato oggettivamente.
      - hook Ã¢â€°Â  escalation/build Ã¢â€°Â  payoff Ã¢â€°Â  loop (NESSUNA ripetizione semantica).
      - Evoluzione reale (startState Ã¢â€°Â  endState).
      - Payoff FORTE (cambiamento visivo/percettivo o micro evento).
      - Output descrittivi o statici -> FAIL.
      Compila l'oggetto "viralValidation" all'interno del nodo "structure".

      PROMPT DURATION (MANDATORY):
      Ogni prompt deve avere versioni per: 15s, 12s, 10s, 8s, 6s.
      NON un taglio semplice -> riscrittura intelligente per adattare il ritmo.
    `;

    // --- ANTI QUOTE WASTE: Skip frames if summary is available and sufficient ---
    const useSummaryOnly = videoSummary && videoSummary.length > 50;
    const finalFrames = useSummaryOnly ? [] : frames;

    const response = await executeWithNetworkRetry(async (currentAi, dynamicModel) =>
        currentAi.models.generateContent({
        model: dynamicModel || model,
          contents: {
            parts: [
              ...finalFrames
                .map((f: any) => {
                  const p = parseDataUrl(f);
                  return p
                    ? { inlineData: { mimeType: p.mimeType, data: p.data } }
                    : null;
                })
                .filter(Boolean),
              { text: prompt },
            ],
          },
          config: {
            systemInstruction: SYSTEM_INSTRUCTION,
            responseMimeType: "application/json",
            responseSchema: BASE_PROMPT_SCHEMA,
          },
        }),
      3,
      undefined,
      300000,
      apiKey,
      undefined,
      model,
      trace,
      "Video Analysis Generation",
      currentModelTier
    );

    const parsed = safeParseJSON(response.text || "{}");

    // --- CORE_INTENT_DRIFT_CHECK ---
    let coreIntentDrift = false;
    if (coreIntentClassification) {
      const intent = coreIntentClassification.coreIntent;
      const outputText = String(`${parsed.structure?.hook || ""} ${parsed.structure?.coreAction || ""} ${parsed.structure?.loop || ""} ${parsed.prompts?.prompt15s || ""} ${parsed.script || ""} ${parsed.publishingKit?.pubTitleIt || ""}`).toLowerCase();
      
      const humanKeywords = ["donna", "uomo", "ragazzo", "ragazza", "bambino", "anziano", "persona", "protagonista", "volto", "sguardo", "gesto", "attore", "human", "person", "woman", "man", "actor", "actress", "guy", "girl", "child", "elderly", "subject", "face", "eyes", "smile", "expression"];
      const productKeywords = ["prodotto", "oggetto", "articolo", "cosa", "dispositivo", "bene", "acquisto", "compralo", "servizio", "dettaglio", "materiale", "pelle", "tessuto", "riflesso", "confezione", "packaging", "product", "item", "object", "device", "purchase", "buy", "service", "good", "commodity", "texture", "material", "leather", "fabric", "reflection", "package"];
      const infoKeywords = ["poster", "documento", "testo", "scritta", "mappa", "asset", "informazione", "grafica", "text", "document", "map", "info", "informational_surface", "graphics"];

      if (intent === 'PERSONA') {
        if (!humanKeywords.some(hk => outputText.includes(hk)) && !outputText.includes(ideaText.toLowerCase())) {
          coreIntentDrift = true;
        }
      } else if (intent === 'PRODOTTO') {
        if (!productKeywords.some(pk => outputText.includes(pk)) && !outputText.includes(ideaText.toLowerCase())) {
           // If product words missing, it might still be ok if it mentions the idea title
           const titleWords = ideaText.toLowerCase().split(" ").filter(w => w.length > 3);
           if (!titleWords.some((w: string) => outputText.includes(w))) {
              coreIntentDrift = true;
           }
        }
      } else if (intent === 'INFORMATIVO') {
        if (!infoKeywords.some(ik => outputText.includes(ik)) && !outputText.includes(ideaText.toLowerCase())) {
          coreIntentDrift = true;
        }
      }
    }

    // Format the prompt with tags as requested by the user
    if (parsed.realityAnchor && parsed.structure && parsed.prompts) {
      const formattedPrompt = `
<reality_anchor>
Credible Action: ${parsed.realityAnchor.credibleAction}
Visual Resistance: ${parsed.realityAnchor.visualResistance}
Neutral Initial State: ${parsed.realityAnchor.neutralInitialState}
Perceptible Weight: ${parsed.realityAnchor.perceptibleWeight}
</reality_anchor>

<struttura>
Hook: ${parsed.structure.hook}
Escalation: ${parsed.structure.escalation}
Core Action: ${parsed.structure.coreAction}
Payoff: ${parsed.structure.payoff}
Loop: ${parsed.structure.loop}
</struttura>

<visual_prompt_15s>
${parsed.prompts.prompt15s}
</visual_prompt_15s>

<visual_prompt_12s>
${parsed.prompts.prompt12s}
</visual_prompt_12s>

<visual_prompt_10s>
${parsed.prompts.prompt10s}
</visual_prompt_10s>

<visual_prompt_8s>
${parsed.prompts.prompt8s}
</visual_prompt_8s>

<visual_prompt_6s>
${parsed.prompts.prompt6s}
</visual_prompt_6s>
`.trim();

      return {
        ...parsed,
        prompt: formattedPrompt,
        coreIntentClassification,
        coreIntentDrift
      };
    }

    return { ...parsed, coreIntentClassification, coreIntentDrift };
  };

  return await executeGeneration(modelTier);
}

