    }

      // --- CONTEXT / TONE STRATEGY OVERRIDE ---
      const intent = coreIntentClassification?.coreIntent;
      const purpose = String(contentHierarchy?.plan?.dominantPurpose || "").toLowerCase();
      const actionCore = String(contentHierarchy?.plan?.actionCore || "").toLowerCase();
      const centralIdea = String(contentHierarchy?.plan?.centralIdea || "").toLowerCase();
      const isWeakAction = actionCore.includes("pacato") || actionCore.includes("debole") || purpose.includes("inform");
      
      const initialStrategy = strategicManifest.strategy;
      let correctedStrategy: StrategicStrategy = initialStrategy;
      let correctionReason = "";

      if (intent === "PERFORMANCE") {
        const isComedyOrStrong = actionCore.includes("comedy") || actionCore.includes("comico") || actionCore.includes("comica") || actionCore.includes("punchline") || actionCore.includes("reazione") || actionCore.includes("sketch") || actionCore.includes("gag") || actionCore.includes("battuta") || actionCore.includes("payoff") || actionCore.includes("delivery comico") || centralIdea.includes("comedy") || centralIdea.includes("comic");
        const isWeakTalk = actionCore.includes("vlog") || actionCore.includes("intervista") || actionCore.includes("spiegazione") || actionCore.includes("informativo") || actionCore.includes("pacato") || actionCore.includes("senza payoff");

        if (isComedyOrStrong) {
          correctedStrategy = "REAL_HUMAN_BEHAVIOR_AND_PERFORMANCE";
          correctionReason = "Conferma PERFORMANCE per azione comedy/delivery forte/payoff.";
        } else if (isWeakAction || isWeakTalk) {
          correctedStrategy = "REAL_HUMAN_PRESENCE";
          correctionReason = `Downgrade PERFORMANCE a PRESENCE per talk/dialogo pacato o senza payoff comico. Action: ${actionCore}`;
        }
      } else if (intent === "REAL_EVENT") {
        if (isWeakAction || actionCore.includes("senza partecipazione") || actionCore.includes("osservazione") || actionCore.includes("vuoto")) {
          correctedStrategy = "OBSERVED_NATURAL_DYNAMICS";
          correctionReason = `Downgrade REAL_EVENT a OBSERVED_NATURAL_DYNAMICS per mancanza di partecipazione attiva. Action: ${actionCore}`;
        }
      } else if (intent === "PERSONA") {
        if (actionCore.includes("comedy") || actionCore.includes("sketch") || actionCore.includes("esibizione") || actionCore.includes("performance") || centralIdea.includes("comedy")) {
          correctedStrategy = "REAL_HUMAN_BEHAVIOR_AND_PERFORMANCE";
          correctionReason = `Upgrade PERSONA a PERFORMANCE per presenza di azione comedy/esibizione. Action: ${actionCore}`;
        }
      }

      if (correctedStrategy !== initialStrategy) {
         logger.info(`[STRATEGY_OVERRIDE] ${initialStrategy} -> ${correctedStrategy}. Motivo: ${correctionReason}`, { actionCore, purpose });
         strategicManifest.strategy = correctedStrategy;
         
         if (correctedStrategy === "REAL_HUMAN_PRESENCE") {
             strategicManifest.primaryActivation = "Storytelling verbale, dialogo, reazione organica pacata.";
         } else if (correctedStrategy === "OBSERVED_NATURAL_DYNAMICS") {
             strategicManifest.primaryActivation = "Evoluzione organica, esplorazione spaziale, dinamismo naturale.";
             strategicManifest.intentDominance = "AMBIENTE";
         } else if (correctedStrategy === "REAL_HUMAN_BEHAVIOR_AND_PERFORMANCE") {
             strategicManifest.primaryActivation = "Performance, escalation emotiva, reazione o azione scenica (comedy, recitazione, coreografia).";
             strategicManifest.intentDominance = "PERSONA";
